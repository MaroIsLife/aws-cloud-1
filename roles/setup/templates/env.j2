# Generated by Ansible (roles/setup/templates/env.j2). Edits here are overwritten.
DB_NAME={{ db_name }}
DB_USER={{ db_user }}
DB_PASSWORD={{ db_password }}
DB_ROOT_PASSWORD={{ db_root_password }}

WP_URL=https://{{ wp_domain }}
WP_TITLE={{ wp_title }}
WP_ADMIN_USER={{ wp_admin_user }}
WP_ADMIN_PASSWORD={{ wp_admin_password }}
WP_ADMIN_EMAIL={{ wp_admin_email }}
WP_ADMIN2_USER={{ wp_admin2_user }}
WP_ADMIN2_PASSWORD={{ wp_admin2_password }}
WP_ADMIN2_EMAIL={{ wp_admin2_email }}

HTTP_PORT={{ http_port }}
HTTPS_PORT={{ https_port }}
WP_DOMAIN={{ wp_domain }}
PMA_DOMAIN={{ pma_domain }}

# http until the Let's Encrypt certificate exists (see roles/tls), then https
NGINX_MODE={{ 'https' if tls_cert.stat.exists else 'http' }}
